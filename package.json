{
    "name": "root",
    "private": true,
    "scripts": {
        "dev": "turbo run dev",
        "backend:build": "node scripts/backend-build.mjs",
        "backend:dev": "node scripts/backend-dev.mjs",
        "dev:frontend": "turbo run dev --filter=@praxis/web-shell",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "docker:up": "docker compose -f infra/docker/compose/docker-compose.yml up -d",
        "docker:down": "docker compose -f infra/docker/compose/docker-compose.yml down",
        "docker:restart": "docker compose -f infra/docker/compose/docker-compose.yml down && docker compose -f infra/docker/compose/docker-compose.yml up -d",
        "docker:logs": "docker compose -f infra/docker/compose/docker-compose.yml logs -f",
        "prisma:generate": "node scripts/backend-prisma.mjs generate",
        "prisma:migrate": "node scripts/backend-prisma.mjs migrate",
        "prisma:reset": "node scripts/backend-prisma.mjs reset",
        "prisma:seed": "node scripts/backend-prisma.mjs seed"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.8.0",
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "turbo": "^2.0.0"
    },
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    },
    "packageManager": "pnpm@9.0.0"
}
