{
    "name": "root",
    "private": true,
    "scripts": {
        "dev:frontend": "turbo run dev --filter='./apps/frontend/*'",
        "dev:cli": "node scripts/dev-cli/index.mjs",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "docker:down": "docker compose -f infra/docker/compose/docker-compose.yml down",
        "docker:logs": "docker compose -f infra/docker/compose/docker-compose.yml logs -f",
        "prisma:deploy": "pnpm --parallel --filter \"@praxis/*-service\" exec prisma migrate deploy",
        "prisma:generate": "pnpm --filter \"@praxis/*-service\" exec prisma generate"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.8.0",
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "inquirer": "^14.0.2",
        "turbo": "^2.0.0"
    },
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    },
    "packageManager": "pnpm@9.0.0"
}
