{
  "name": "@praxis/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas end-to-end de PRAXIS: contrato del gateway y recorridos de navegador sobre el multi-zone.",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
