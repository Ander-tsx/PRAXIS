    "test:seguridad": "playwright test --grep @security",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4100"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0"
  }
}
