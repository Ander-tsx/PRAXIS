# Servidor HTTP
HTTP_PORT=3000

# Logging
NODE_ENV=development
LOG_LEVEL=info

# JWT — debe ser el mismo secret que usa credentials-service
JWT_SECRET=

# credentials-service (auth + users) — TCP 3001
CREDENTIALS_SERVICE_HOST=localhost
CREDENTIALS_SERVICE_PORT=3001

# permissions-service — TCP 3002
PERMISSIONS_SERVICE_HOST=localhost
PERMISSIONS_SERVICE_PORT=3002

# projects-service — TCP 3003
PROJECTS_SERVICE_HOST=localhost
PROJECTS_SERVICE_PORT=3003

# tasks-service — TCP 3004
TASKS_SERVICE_HOST=localhost
TASKS_SERVICE_PORT=3004


# reports-service — TCP 3005
REPORTS_SERVICE_HOST=localhost
REPORTS_SERVICE_PORT=3005
