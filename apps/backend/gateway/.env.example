# Servidor HTTP
HTTP_PORT=3000

# Logging
NODE_ENV=development
LOG_LEVEL=info

# JWT — debe ser el mismo secret que usa credentials-service
JWT_SECRET=

# credentials-service (auth + users) — TCP 3001
CREDENTIALS_SERVICE_HOST=localhost
CREDENTIALS_SERVICE_PORT=3001

# roles-service — TCP 3002
ROLES_SERVICE_HOST=localhost
ROLES_SERVICE_PORT=3002

# projects-service — TCP 3003
PROJECTS_SERVICE_HOST=localhost
PROJECTS_SERVICE_PORT=3003
