# Servidor HTTP
HTTP_PORT=3000

# Logging
NODE_ENV=development
LOG_LEVEL=info

# JWT — debe ser el mismo secret que usa credentials-service
JWT_SECRET=

# credentials-service (auth + users) — TCP 3001
CREDENTIALS_SERVICE_HOST=localhost
CREDENTIALS_SERVICE_PORT=3001

# permissions-service — TCP 3002
PERMISSIONS_SERVICE_HOST=localhost
PERMISSIONS_SERVICE_PORT=3002

# projects-service — TCP 3003
PROJECTS_SERVICE_HOST=localhost
PROJECTS_SERVICE_PORT=3003

# tasks-service — TCP 3004
TASKS_SERVICE_HOST=localhost
TASKS_SERVICE_PORT=3004

# reports-service — TCP 3005
REPORTS_SERVICE_HOST=localhost
REPORTS_SERVICE_PORT=3005

# assistant-service — TCP 3006
# ⚠️ La clave de Gemini NO va aquí: vive solo en el .env de assistant-service.
ASSISTANT_SERVICE_HOST=localhost
ASSISTANT_SERVICE_PORT=3006

# alexa-service (capa de voz, solo lectura) — TCP 3007
ALEXA_SERVICE_HOST=localhost
ALEXA_SERVICE_PORT=3007

# ─── Stripe (plan PRO del asistente) ────────────────────────────────────
#
# Las tres son OPCIONALES: sin ellas la facturación se apaga sola, el arranque
# lo avisa una vez y /me/billing/* responde 503. Así se puede levantar el
# entorno —y CI— sin cuenta de Stripe.
#
# ⚠️ Es la única excepción a que el gateway no hable con terceros, y no hay
# alternativa: el webhook necesita una URL pública y esta es la única que hay.
#
# En modo de prueba todo esto es gratis y las tarjetas de prueba funcionan de
# punta a punta (4242 4242 4242 4242, cualquier fecha futura y CVC).
STRIPE_SECRET_KEY=
# El precio recurrente del plan PRO, `price_...`. Sin él no hay qué cobrar.
STRIPE_PRICE_PRO=
# ⚠️ El secreto del webhook, `whsec_...`. Es la ÚNICA autenticación de
# /api/webhooks/stripe: sin él, el manejador rechaza todo, y aceptar sin firma
# sería regalarle el plan PRO a cualquiera con un curl.
#
# En local se obtiene con:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# A dónde vuelve el navegador tras pagar. La misma que usan los enlaces de los
# correos. Sin ella, Stripe devolvería a localhost desde producción.
PUBLIC_APP_URL=http://localhost:4100

# Cuántos flujos SSE puede tener abiertos una misma cuenta a la vez.
#
# Cada uno es un socket sostenido, un Subject en memoria y un latido cada 25 s
# indefinidamente: sin tope, cien pestañas son cien conexiones contra el gateway.
# El tercero por encima del tope recibe 429 TOO_MANY_STREAMS, y EventSource no
# reintenta ante un no-200 — que es justo lo que evita la tormenta.
#
# 10 por defecto: una pestaña por zona abierta y alguna repetida.
SSE_MAX_CONEXIONES_POR_CUENTA=10
