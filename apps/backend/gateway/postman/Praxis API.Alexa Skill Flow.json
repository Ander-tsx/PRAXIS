    {
      "name": "08. Crear Tarea 1 (En Progreso)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let uid = pm.collectionVariables.get('userId') || pm.environment.get('userId');",
              "if (!uid || typeof uid !== 'string' || uid.trim() === '') {",
              "    const token = pm.collectionVariables.get('access_token') || pm.environment.get('access_token');",
              "    if (token && typeof token === 'string') {",
              "        try {",
              "            const payloadBase64 = token.split('.')[1];",
              "            const payloadJson = atob(payloadBase64);",
              "            const payload = JSON.parse(payloadJson);",
              "            uid = payload.sub || payload.userId;",
              "            if (uid) {",
              "                pm.collectionVariables.set('userId', uid);",
              "            }",
              "        } catch(e) {}",
              "    }",
              "}",
              "const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
              "if (uid && uuidRegex.test(uid.trim())) {",
              "    pm.variables.set('assignees_clause', ',\\n  \"assigneeIds\": [\"' + uid.trim() + '\"]');",
              "} else {",
              "    pm.variables.set('assignees_clause', '');",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    const res = body.data || body;",
              "    if (res.id) pm.collectionVariables.set('taskId_1', res.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"columnId\": \"{{columnId_doing}}\",\n  \"title\": \"Diseñar vistas de interfaz para Alexa\",\n  \"status\": \"En Progreso\",\n  \"description\": \"Crear componentes web y prototipos\"{{assignees_clause}}\n}",
