  "item": [
    {
      "name": "01. Web Auth · Login (Obtener Token Web)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 201\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    const res = body.data || body;",
              "    const token = res.accessToken || res.access_token;",
              "    if (token) {",
              "        pm.collectionVariables.set('access_token', token);",
              "        console.log('✅ Token Web de usuario guardado en access_token');",
              "        try {",
              "            const payloadBase64 = token.split('.')[1];",
              "            const payloadJson = atob(payloadBase64);",
              "            const payload = JSON.parse(payloadJson);",
              "            const uid = payload.sub || payload.userId || res.userId || res.id;",
              "            if (uid) {",
              "                pm.collectionVariables.set('userId', uid);",
              "                console.log('✅ ID de usuario guardado en userId:', uid);",
              "            }",
              "        } catch (e) {",
              "            console.error('⚠️ No se pudo extraer userId del JWT:', e.message);",
              "        }",
              "    }",
              "} else {",
              "    console.error('❌ Login web falló: ' + pm.response.text());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@praxis.dev\",\n  \"password\": \"Admin@12345!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
