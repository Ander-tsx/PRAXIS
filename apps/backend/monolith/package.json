    "@praxis/automation-service": "workspace:*",
    "@praxis/billing-service": "workspace:*",
    "@praxis/collab-service": "workspace:*",
    "@praxis/credentials-service": "workspace:*",
    "@praxis/gateway": "workspace:*",
    "@praxis/local-transport": "workspace:*",
    "@praxis/permissions-service": "workspace:*",
    "@praxis/projects-service": "workspace:*",
    "@praxis/reports-service": "workspace:*",
