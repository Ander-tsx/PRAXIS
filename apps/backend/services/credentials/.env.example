DATABASE_URL=postgresql://praxis:praxis123@localhost:5432/praxis?schema=credentials
REDIS_URL=redis://localhost:6379
TCP_PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOG_LEVEL=info
NODE_ENV=development

# ID de cliente de OAuth. El servicio lo necesita para comprobar que el `aud`
# del token de Google es el nuestro; sin esa comprobación valdría cualquier ID
# token de Google, incluido el emitido para otra aplicación cualquiera.
#
# Opcional: sin él la entrada con contraseña funciona igual y la ruta de Google
# responde 503.
GOOGLE_CLIENT_ID=
MAIL_API_KEY=

# Kyloo Accounts como proveedor de identidad (OIDC, código + PKCE). Las tres juntas
# o ninguna: sin ellas "Continuar con Kyloo" responde 503 y el resto sigue igual.
#
# El cliente se da de alta en KYLOO-AUTH con
#   pnpm --filter @kyloo-auth/api run seed:clients praxis <redirect_uri>
# donde <redirect_uri> es {origen público de la web}/auth/api/kyloo/callback.
# El secreto vive SOLO aquí; el servidor web nunca lo ve.
KYLOO_ISSUER=
KYLOO_CLIENT_ID=
KYLOO_CLIENT_SECRET=
