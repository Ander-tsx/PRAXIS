generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["credentials"]
  url      = env("DATABASE_URL")
}

model Credential {
  id    String @id @default(uuid())
  email String @unique

  /// Nulo cuando la cuenta entra **solo** con Google: no hay contraseña que
  /// guardar, y poner una cadena vacía o un hash falso sería peor —
  /// convertiría "no tiene contraseña" en "tiene una que nadie conoce", que es
  /// justo lo que no se puede distinguir después.
  passwordHash String?

  /// El `sub` del token de Google: su identificador **estable** de la cuenta.
  ///
  /// ⚠️ No se usa el correo como clave de identidad aunque sea más cómodo. Un
  /// correo de Google puede cambiar de dueño (dominios corporativos que se
  /// reasignan) o cambiar de nombre; el `sub` no. Vincular por correo es
  /// exactamente el error que permite heredar la cuenta de otra persona.
  googleSub String? @unique

  /// El `sub` del id_token de Kyloo Accounts: la identidad estable de la persona en todo el
  /// ecosistema Kyloo. Mismo razonamiento que `googleSub`: se vincula por este identificador y
  /// no por el correo, que puede cambiar en Accounts sin que Praxis se entere.
  kylooSub String? @unique

  /// Cuándo se confirmó el correo. Nulo = sin confirmar.
  ///
  /// ⚠️ **Una fecha y no un booleano.** «Está verificado» se responde igual con
  /// las dos, pero solo la fecha responde «desde cuándo», que es lo que hace
  /// falta el día que haya que investigar una cuenta.
  ///
  /// Las cuentas que entran con Google nacen verificadas: el `email_verified`
  /// de su token ya se exige en `loginWithGoogle`, y volver a pedirlo sería
  /// mandar un correo para confirmar algo que Google acaba de confirmar.
  emailVerifiedAt DateTime?

  user      User?
  tokens    AuthToken[]
  createdAt DateTime    @default(now())

  @@map("credentials")
  @@schema("credentials")
}

model User {
  id                   String                @id @default(uuid())
  personalAccessTokens PersonalAccessToken[]
  mcpConnections       McpConnection[]
  credentialId         String                @unique
  credential           Credential            @relation(fields: [credentialId], references: [id])
  firstName            String
  lastName             String

  /// Ruta **relativa al gateway** de la foto, con una marca de versión:
  /// `/users/<id>/avatar?v=<epoch>`. La zona le antepone su propio proxy.
  ///
  /// ⚠️ Guarda una ruta y no los bytes —esos van en `UserAvatar`— y lleva la
  /// versión dentro **a propósito**: sin ella, cambiar de foto no cambia la URL
  /// y el navegador seguiría enseñando la vieja desde su caché durante horas.
  /// Rutas y archivos
  avatarUrl       String?
  /// La foto de la cuenta de Google, **aparte** de `avatarUrl`: subir o quitar la
  /// propia no la pierde, y se puede volver a ella. Se renueva en cada entrada con Google.
  googleAvatarUrl String?
  coverUrl        String?

  /// Campos de perfil
  biography        String?
  location         String?
  professionalInfo Json?

  /// Estado **administrativo** de la cuenta. No es la presencia: ver `presence`.
  status UserStatus @default(ACTIVE)

  /// Lo que la persona dice que está haciendo, y lo elige ella.
  ///
  /// ⚠️ **No se confunda con `status`.** Aquel lo pone la plataforma y decide si
  /// la cuenta sirve; este lo pone su dueño y solo informa al resto del equipo.
  /// Tenerlos con nombres parecidos ya invita a la confusión, así que el que
  /// manda en el acceso es siempre `status`.
  ///
  /// Es manual y se queda hasta que se cambie: no hay latidos ni caducidad.
  /// Marcar «Disponible» automáticamente al abrir la aplicación necesitaría
  /// presencia en vivo, y eso es otra cosa —y otra decisión—.
  presence UserPresence @default(AWAY)

  avatar UserAvatar?
  cover  UserCover?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@schema("credentials")
}

/// La foto de perfil, **en su propia tabla**.
///
/// Aparte de `User` por lo mismo que los adjuntos del chat viven fuera del
/// mensaje: son cientos de kilobytes que no se necesitan casi nunca, y tenerlos
/// en la misma fila obliga a arrastrarlos en cada consulta de perfil —que se
/// hacen a decenas por pantalla—. Aquí solo se leen en la ruta que los sirve.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  bytes     Bytes
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
  @@schema("credentials")
}

/// La foto de portada, separada de `User` por los mismos motivos que `UserAvatar`.
model UserCover {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  bytes     Bytes
  updatedAt DateTime @updatedAt

  @@map("user_covers")
  @@schema("credentials")
}

/// Para qué sirve un token de un solo uso.
enum AuthTokenType {
  /// Confirmar el correo de una cuenta recién creada.
  EMAIL_VERIFICATION
  /// Poner una contraseña nueva sin saber la anterior.
  PASSWORD_RESET

  @@schema("credentials")
}

/// Un token de un solo uso, enviado por correo.
///
/// ⚠️ **Se guarda el hash, nunca el token.** Es exactamente el mismo criterio
/// que con las contraseñas y por el mismo motivo: quien lea esta tabla —una
/// copia de seguridad, un volcado, un `SELECT` de más— no puede usar lo que ve.
/// El token de verdad solo existe dentro del enlace que se manda por correo.
///
/// `usedAt` en vez de borrar la fila: así un enlace reutilizado se distingue de
/// uno inventado, y se le puede decir a la persona «este enlace ya se usó» en
/// lugar de «no existe».
model AuthToken {
  id           String        @id @default(uuid())
  credentialId String
  credential   Credential    @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  type         AuthTokenType
  /// SHA-256 del token en claro. Único: dos tokens no pueden colisionar.
  tokenHash    String        @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime      @default(now())

  /// Para invalidar los anteriores al emitir uno nuevo, sin recorrer la tabla.
  @@index([credentialId, type])
  @@map("auth_tokens")
  @@schema("credentials")
}

/// Un token personal de acceso: la llave que una persona le da a su propio
/// agente de IA (Claude, Cursor…) para entrar en Praxis por MCP.
///
/// docs/PLAN-MCP.md, M3. Lo esencial:
///
/// - **Se guarda el hash, nunca el token.** Igual que `AuthToken`: SHA-256,
///   porque son 32 bytes al azar que no se adivinan. El token en claro se
///   enseña **una vez**, al crearlo. `prefix` es lo único legible, para que la
///   persona lo reconozca en la lista.
/// - **Vale para UNA organización** (`organizationId`), elegida al crearlo y
///   validada contra la pertenencia en el gateway. El agente no la elige
///   (I2): sale de aquí.
/// - **Alcances**: `read`, `write`, `delete`. `write` incluye `read`; `delete`
///   va aparte. Por defecto solo `read`.
/// - **Revocar es poner `revokedAt`**, no borrar: la lista enseña los revocados
///   un tiempo y se distingue «revocado» de «nunca existió». Cambiar la
///   contraseña los revoca todos (I4). Una cuenta suspendida no los revoca:
///   el canje comprueba el estado en cada llamada, y al reactivarla vuelven.
model PersonalAccessToken {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  /// SHA-256 del token en claro.
  tokenHash      String    @unique
  /// Los primeros caracteres del token (`prx_` + 8), para reconocerlo.
  prefix         String
  scopes         String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@map("personal_access_tokens")
  @@schema("credentials")
}

/// Un cliente de IA (ChatGPT, Claude…) conectado al MCP de Praxis **por OAuth**, con la
/// identidad de Kyloo Accounts. Es la contraparte de `PersonalAccessToken` para quien
/// no puede pegar un token en un archivo.
///
/// Se diferencia en lo importante: un token personal vale para UNA organización; una
/// conexión lleva un conjunto (`allowedOrgIds`) y una activa (`activeOrgId`), y se cambia
/// de una a otra **sin reconectar**. El token OAuth que lleva el cliente no contiene la
/// organización —solo el id de esta fila—, así que cambiarla o revocarla surte efecto en
/// la siguiente llamada, no cuando caduque el token.
///
/// Una por (persona, cliente): volver a conectar el mismo cliente actualiza la fila.
model McpConnection {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// El `client_id` en Kyloo Accounts.
  clientId      String
  clientName    String
  /// El `sub` de Kyloo Accounts. El token OAuth tiene que traer este mismo: es lo que
  /// ata la conexión a esa identidad y no a "quien presente este id".
  kylooSub      String
  allowedOrgIds String[]
  activeOrgId   String
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, clientId])
  @@map("mcp_connections")
  @@schema("credentials")
}

/// Lo que un agente de IA hizo por el MCP, a nombre de una persona. Una fila por cada
/// escritura que **salió bien**; las lecturas no se anotan.
///
/// Es el registro de coautoría: lo escribe el gateway desde el JWT que firma este mismo
/// servicio (`via: 'mcp'`), así que no depende de lo que diga el agente. No tiene
/// claves foráneas a propósito: es un hecho del pasado, y tiene que poder leerse
/// cuando la tarea o el proyecto ya no existen.
model McpAction {
  id         String   @id @default(uuid())
  userId     String
  /// El token personal o la conexión OAuth.
  agentId    String
  agentName  String
  /// `claude` | `chatgpt` | `ai`.
  agentKind  String
  /// `POST /tasks/:taskId/comments`: el patrón de la ruta, sin ids ni contenido.
  route      String
  /// `task` (editar la tarea), `checklist`, `comment` u `other`.
  area       String
  entityId   String?
  taskId     String?
  projectId  String?
  createdAt  DateTime @default(now())

  @@index([taskId, area, createdAt])
  @@index([userId, createdAt])
  @@map("mcp_actions")
  @@schema("credentials")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@schema("credentials")
}

/// Lo que alguien dice que está haciendo. Lo elige y lo cambia esa persona.
///
/// El conjunto es cerrado a propósito: un texto libre por persona convierte la
/// lista del equipo en algo que no se puede leer de un vistazo ni traducir, y
/// con seis opciones ya se cubre lo que se quiere decir en el trabajo.
enum UserPresence {
  AVAILABLE
  BUSY
  IN_MEETING
  EATING
  AWAY
  DO_NOT_DISTURB

  @@schema("credentials")
}
