generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["credentials"]
  url      = env("DATABASE_URL")
}

model Credential {
  id    String @id @default(uuid())
  email String @unique

  /// Nulo cuando la cuenta entra **solo** con Google: no hay contraseña que
  /// guardar, y poner una cadena vacía o un hash falso sería peor —
  /// convertiría "no tiene contraseña" en "tiene una que nadie conoce", que es
  /// justo lo que no se puede distinguir después.
  passwordHash String?

  /// El `sub` del token de Google: su identificador **estable** de la cuenta.
  ///
  /// ⚠️ No se usa el correo como clave de identidad aunque sea más cómodo. Un
  /// correo de Google puede cambiar de dueño (dominios corporativos que se
  /// reasignan) o cambiar de nombre; el `sub` no. Vincular por correo es
  /// exactamente el error que permite heredar la cuenta de otra persona.
  googleSub String? @unique

  /// Cuándo se confirmó el correo. Nulo = sin confirmar.
  ///
  /// ⚠️ **Una fecha y no un booleano.** «Está verificado» se responde igual con
  /// las dos, pero solo la fecha responde «desde cuándo», que es lo que hace
  /// falta el día que haya que investigar una cuenta.
  ///
  /// Las cuentas que entran con Google nacen verificadas: el `email_verified`
  /// de su token ya se exige en `loginWithGoogle`, y volver a pedirlo sería
  /// mandar un correo para confirmar algo que Google acaba de confirmar.
  emailVerifiedAt DateTime?

  user      User?
  tokens    AuthToken[]
  createdAt DateTime    @default(now())

  @@map("credentials")
  @@schema("credentials")
}

model User {
  id           String     @id @default(uuid())
  credentialId String     @unique
  credential   Credential @relation(fields: [credentialId], references: [id])
  firstName    String
  lastName     String

  /// Ruta **relativa al gateway** de la foto, con una marca de versión:
  /// `/users/<id>/avatar?v=<epoch>`. La zona le antepone su propio proxy.
  ///
  /// ⚠️ Guarda una ruta y no los bytes —esos van en `UserAvatar`— y lleva la
  /// versión dentro **a propósito**: sin ella, cambiar de foto no cambia la URL
  /// y el navegador seguiría enseñando la vieja desde su caché durante horas.
  avatarUrl String?

  /// Estado **administrativo** de la cuenta. No es la presencia: ver `presence`.
  status UserStatus @default(ACTIVE)

  /// Lo que la persona dice que está haciendo, y lo elige ella.
  ///
  /// ⚠️ **No se confunda con `status`.** Aquel lo pone la plataforma y decide si
  /// la cuenta sirve; este lo pone su dueño y solo informa al resto del equipo.
  /// Tenerlos con nombres parecidos ya invita a la confusión, así que el que
  /// manda en el acceso es siempre `status`.
  ///
  /// Es manual y se queda hasta que se cambie: no hay latidos ni caducidad.
  /// Marcar «Disponible» automáticamente al abrir la aplicación necesitaría
  /// presencia en vivo, y eso es otra cosa —y otra decisión—.
  presence UserPresence @default(AVAILABLE)

  avatar UserAvatar?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@schema("credentials")
}

/// La foto de perfil, **en su propia tabla**.
///
/// Aparte de `User` por lo mismo que los adjuntos del chat viven fuera del
/// mensaje: son cientos de kilobytes que no se necesitan casi nunca, y tenerlos
/// en la misma fila obliga a arrastrarlos en cada consulta de perfil —que se
/// hacen a decenas por pantalla—. Aquí solo se leen en la ruta que los sirve.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  bytes     Bytes
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
  @@schema("credentials")
}

/// Para qué sirve un token de un solo uso.
enum AuthTokenType {
  /// Confirmar el correo de una cuenta recién creada.
  EMAIL_VERIFICATION
  /// Poner una contraseña nueva sin saber la anterior.
  PASSWORD_RESET

  @@schema("credentials")
}

/// Un token de un solo uso, enviado por correo.
///
/// ⚠️ **Se guarda el hash, nunca el token.** Es exactamente el mismo criterio
/// que con las contraseñas y por el mismo motivo: quien lea esta tabla —una
/// copia de seguridad, un volcado, un `SELECT` de más— no puede usar lo que ve.
/// El token de verdad solo existe dentro del enlace que se manda por correo.
///
/// `usedAt` en vez de borrar la fila: así un enlace reutilizado se distingue de
/// uno inventado, y se le puede decir a la persona «este enlace ya se usó» en
/// lugar de «no existe».
model AuthToken {
  id           String        @id @default(uuid())
  credentialId String
  credential   Credential    @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  type         AuthTokenType
  /// SHA-256 del token en claro. Único: dos tokens no pueden colisionar.
  tokenHash    String        @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime      @default(now())

  /// Para invalidar los anteriores al emitir uno nuevo, sin recorrer la tabla.
  @@index([credentialId, type])
  @@map("auth_tokens")
  @@schema("credentials")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@schema("credentials")
}

/// Lo que alguien dice que está haciendo. Lo elige y lo cambia esa persona.
///
/// El conjunto es cerrado a propósito: un texto libre por persona convierte la
/// lista del equipo en algo que no se puede leer de un vistazo ni traducir, y
/// con seis opciones ya se cubre lo que se quiere decir en el trabajo.
enum UserPresence {
  AVAILABLE
  BUSY
  IN_MEETING
  EATING
  AWAY
  DO_NOT_DISTURB

  @@schema("credentials")
}
