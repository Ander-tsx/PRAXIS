{
  "name": "@praxis/automation-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate --schema ./prisma/schema.prisma",
    "build": "nest build",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest --passWithNoTests",
    "test:int": "jest --passWithNoTests --testRegex '.*\\.integration\\.spec\\.ts$' --testPathIgnorePatterns '/node_modules/'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@praxis/local-transport": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@praxis/contracts": "workspace:*",
    "@praxis/observability": "workspace:*",
    "@prisma/adapter-pg": "^6.0.0",
    "@prisma/client": "6.19.3",
    "ioredis": "^5.3.2",
    "joi": "^17.12.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": ["/node_modules/", "\\.integration\\.spec\\.ts$"],
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
