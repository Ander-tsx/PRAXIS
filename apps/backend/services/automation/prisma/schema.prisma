generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["automation"]
  url      = env("DATABASE_URL")
}

enum InboundEventStatus {
  ACCEPTED

  @@schema("automation")
}

enum AutomationRuleStatus {
  ENABLED
  DISABLED
  PAUSED_SYSTEM
  INVALID

  @@schema("automation")
}

enum RuleExecutionStatus {
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED

  @@schema("automation")
}

/// Copia durable e idempotente de un hecho recibido por Redis Streams.
///
/// `eventId` identifica el hecho de dominio y `dedupeKey` es un hash canónico
/// estable que permite absorber sobres distintos de la misma causa.
model InboundEvent {
  id            String             @id @default(uuid())
  eventId       String             @unique
  dedupeKey     String             @unique
  streamId      String
  type          String
  source        String
  occurredAt    DateTime
  projectId     String
  subjectType   String
  subjectId     String
  actorType     String
  actorId       String?
  correlationId String
  causationId   String?
  payload       Json
  status        InboundEventStatus @default(ACCEPTED)
  receivedAt    DateTime           @default(now())

  @@index([projectId, receivedAt])
  @@index([status, receivedAt])
  @@schema("automation")
  @@map("inbound_events")
}

model AutomationRule {
  id              String               @id @default(uuid())
  projectId       String
  name            String
  description     String?
  createdBy       String
  version         Int                  @default(1)
  status          AutomationRuleStatus @default(DISABLED)
  pausedAt        DateTime?
  pauseReason     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  trigger         AutomationTrigger?
  conditions      AutomationCondition[]
  actions         AutomationAction[]
  executions      RuleExecution[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@schema("automation")
  @@map("automation_rules")
}

/// Auditoría mínima de una evaluación directa del MVP académico.
model RuleExecution {
  id              String              @id @default(uuid())
  ruleId          String
  ruleVersion     Int
  causeKey        String
  ruleSnapshot    Json
  conditionResult Json
  actionResults   Json?
  status          RuleExecutionStatus @default(RUNNING)
  error           Json?
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  rule            AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, causeKey])
  @@index([ruleId, createdAt])
  @@index([status, createdAt])
  @@schema("automation")
  @@map("rule_executions")
}

model AutomationTrigger {
  id        String         @id @default(uuid())
  ruleId    String         @unique
  type      String
  config    Json
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@schema("automation")
  @@map("automation_triggers")
}

model AutomationCondition {
  id        String         @id @default(uuid())
  ruleId    String
  field     String
  operator  String
  value     Json
  position  Int
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, position])
  @@schema("automation")
  @@map("automation_conditions")
}

model AutomationAction {
  id        String         @id @default(uuid())
  ruleId    String
  type      String
  config    Json
  position  Int
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, position])
  @@schema("automation")
  @@map("automation_actions")
}
