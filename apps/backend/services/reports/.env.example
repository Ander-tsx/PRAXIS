# reports-service — TCP 3005
#
# ⚠️ NO lleva DATABASE_URL: este servicio no tiene tablas propias. Lee de
# tasks-service y projects-service por TCP y cachea en Redis.

REDIS_URL=redis://localhost:6379
TCP_PORT=3005

TASKS_SERVICE_HOST=localhost
TASKS_SERVICE_PORT=3004
PROJECTS_SERVICE_HOST=localhost
PROJECTS_SERVICE_PORT=3003

LOG_LEVEL=info
NODE_ENV=development
