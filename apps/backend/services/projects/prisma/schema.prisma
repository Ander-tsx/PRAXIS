generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["projects"]
}

model Project {
  id          String          @id @default(uuid())
  /// Único **por dueño**, no globalmente: dos equipos distintos pueden tener
  /// cada uno su "Sprint 1". Antes era `@unique` a secas y el nombre chocaba con
  /// el proyecto de gente que no conoces, sin forma de saber por qué.
  name        String

  /// El identificador legible de la URL: `/projects/rediseno-del-panel`.
  ///
  /// Único **global**, a diferencia de `name`, porque quien resuelve una URL es
  /// una persona que puede ver proyectos de varios dueños —dos "Sprint 1" de
  /// equipos distintos— y ahí el nombre solo no desambigua. Los choques se
  /// resuelven con un sufijo numérico (`sprint-1-2`) que pone
  /// `generarSlugUnico`; nadie lo escribe a mano, así que la unicidad global no
  /// devuelve el conflicto incomprensible que quitó `20260730020000`.
  ///
  /// Se regenera al renombrar. Los enlaces con el UUID **siguen funcionando
  /// siempre**: el guard acepta las dos formas, y por eso no hace falta guardar
  /// los slugs viejos.
  slug        String          @unique

  description String?

  /// Identidad visual del proyecto, elegida en su modal de configuración.
  ///
  /// `iconKey` es el nombre kebab-case de un icono de `lucide-react` de la lista
  /// curada del frontend; `color` es un `#rrggbb`. Anulables: sin ellos el
  /// frontend cae al monograma —dos letras sobre un color derivado del `id`—.
  /// El backend solo los guarda y los devuelve.
  iconKey     String?
  color       String?

  /// Quién es **responsable** del proyecto.
  ///
  /// ⚠️ **Ya no es «el dueño», aunque la columna siga llamándose así.** Desde
  /// 2026-08-26 el proyecto pertenece a una organización; esta persona es quien
  /// responde por él, y sigue siendo el **único bypass total** de permisos —ni el
  /// rol global de plataforma ni ningún rol de proyecto lo alcanzan—. La columna
  /// no se renombra porque `ownerId` aparece en cuarenta sitios entre servicios
  /// sin clave foránea que los ate, y un renombre a medias es peor que un nombre
  /// heredado: lo que se renombró es lo que lee una persona.
  ///
  /// Se puede traspasar, por dos caminos: voluntario, o forzado por quien tenga
  /// `canManageAllProjects` en la organización, y entonces queda en el registro.
  ownerId     String

  /// A qué organización pertenece.
  ///
  /// 🔴 **Es la pieza que convierte PRAXIS en un producto de equipos.** Antes el
  /// proyecto colgaba de una persona y la organización solo repartía topes más
  /// altos: la pregunta «¿qué nos da estar dentro?» no tenía buena respuesta, y
  /// cuando alguien se iba de la empresa su trabajo se iba con él.
  ///
  /// ⚠️ **`NOT NULL` desde el primer día, y sin fase nullable.** La base se
  /// reinicia, así que no hay nada que rellenar: lo que habría sido un script de
  /// relleno que solo se ejecuta una vez está en las semillas, donde se lee.
  ///
  /// ⚠️ **No hay clave foránea**: las organizaciones viven en billing-service, en
  /// otro esquema y bajo otro dueño. Es la regla que ya siguen `ownerId`,
  /// `assigneeId` y `task_events`.
  organizationId String

  /// Estado administrativo del proyecto. Ver `ProjectStatus`.
  status      ProjectStatus   @default(ACTIVE)
  /// Cuándo se suspendió o archivó. `null` mientras esté activo.
  suspendedAt DateTime?
  /// Quién lo hizo. Un administrador de la plataforma, no del proyecto.
  suspendedBy String?
  /**
   * Por qué.
   *
   * ⚠️ **Vive aquí y no solo en el registro de actividad**, y es lo que hace
   * posible el aviso obligatorio de la pantalla del proyecto: ese registro es
   * admin-only, así que si el motivo estuviera solo allí, el dueño vería un
   * proyecto donde nada funciona y ni una palabra que lo explique. Sin esto, cada
   * botón falla en silencio y parece roto.
   */
  suspendedReason String?

  workspaces  Workspace[]
  members     ProjectMember[]
  roles       ProjectRole[]
  invitations ProjectInvitation[]
  chatChannel ChatChannel?
  /// Los lienzos de Análisis, uno por persona. Cascadean con el proyecto.
  reportLayouts ReportLayout[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([ownerId, name])
  @@index([organizationId])
  /// El inventario del panel filtra por estado, y los listados normales excluyen
  /// los archivados.
  @@index([status])
  @@schema("projects")
  @@map("projects")
}

/// Hechos durables pendientes de publicación. No tiene transporte en esta etapa.
model DomainOutbox {
  id            String   @id @default(uuid())
  eventId       String   @unique
  type          String
  source        String
  occurredAt    DateTime
  projectId     String
  subjectType   String
  subjectId     String
  actorType     String
  actorId       String?
  correlationId String
  causationId   String?
  payload       Json
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([publishedAt, createdAt])
  @@index([projectId, createdAt])
  @@schema("projects")
  @@map("domain_outbox")
}

/// Estado administrativo de un proyecto.
///
/// ## Por qué son estados y no un borrado
///
/// `DELETE /projects/:id` ya existe y **se queda con el dueño**: cascadea, purga
/// las tareas en otro microservicio y es irreversible. Un administrador que se
/// equivoca con eso no tiene vuelta atrás, así que el panel no lo ofrece. Lo que
/// ofrece son dos estados, y los dos se deshacen.
enum ProjectStatus {
  ACTIVE
  /**
   * Solo lectura. El dueño y los miembros lo siguen viendo entero —tableros,
   * tareas, comentarios— y **ninguna acción funciona**.
   *
   * Se aplica en `ProjectPermissionGuard`, que ya resuelve el proyecto de cada
   * petición: una comprobación ahí cubre tareas, columnas, comentarios, adjuntos,
   * miembros, roles y etiquetas de golpe, sin tocar los servicios.
   */
  SUSPENDED
  /**
   * Retirado de la vista de todos menos del administrador, y recuperable.
   *
   * Conserva su `slug`, igual que un proyecto suspendido: recuperarlo tiene que
   * devolverte tu URL. Por eso el slug sigue ocupado y no lo puede tomar un
   * proyecto nuevo.
   */
  DELETED

  @@schema("projects")
}

/// Qué contiene un espacio: o tableros o documentos, nunca las dos cosas
/// (`docs/PLAN-DOCUMENTOS.md`, D7). En la interfaz: «Tableros» y «Documentos».
enum WorkspaceKind {
  BOARDS
  DOCUMENTS

  @@schema("projects")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  /// Todos los espacios anteriores son de tableros: el valor por defecto es
  /// justo lo que ya eran.
  kind      WorkspaceKind @default(BOARDS)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boards    Board[]
  /// Un espacio agrupa tableros **y documentos** (`docs/PLAN-DOCUMENTOS.md`).
  documents Document[]
  createdAt DateTime @default(now())

  @@unique([projectId, name])
  @@schema("projects")
  @@map("workspaces")
}

/// Un documento en Markdown dentro de un espacio (`docs/PLAN-DOCUMENTOS.md`).
///
/// Con clave foránea y cascada, al revés que las tareas: vive en el mismo
/// esquema que `Workspace`, así que borrar el espacio o el proyecto se lo lleva
/// sin purga a mano.
model Document {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  /// Markdown, sin HTML. Hasta 100 000 caracteres (D2).
  content     String    @default("")
  /// Sin clave foránea: las personas viven en credentials-service.
  createdBy   String
  updatedBy   String
  createdAt   DateTime  @default(now())
  /// El `PATCH` lo compara con `expectedUpdatedAt`: si alguien guardó entre
  /// medias, 409 y no se pisa nada (D4).
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@schema("projects")
  @@map("documents")
}

model Board {
  id          String        @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     BoardColumn[]
  createdAt   DateTime      @default(now())

  /// Si este tablero, además de Kanban (que todo tablero ya es, por sus
  /// columnas), trabaja también por sprints.
  ///
  /// ⚠️ **No existe `Board.method`.** Kanban no es un modo alterno a Scrum: es
  /// la base que todo tablero ya tiene. Esto enciende o apaga una capa
  /// encima — nunca cambia lo que las columnas hacen. Ver
  /// `docs/PLAN-SCRUM-KANBAN.md`, D1.
  ///
  /// Editable en cualquier momento, no solo al crear el tablero: apagarlo no
  /// borra ningún sprint ni ninguna tarea (D1, invariante 3), así que fijarlo
  /// para siempre no daría ninguna seguridad real.
  scrumEnabled Boolean      @default(false)
  sprints      Sprint[]

  @@schema("projects")
  @@map("boards")
}

/// PLANNED: creado, todavía no arrancó. ACTIVE: en curso. CLOSED: terminado,
/// de solo lectura. Como mucho un ACTIVE por tablero — lo aplica el servicio,
/// no hay forma de expresar la restricción en el schema sin un índice parcial
/// que Prisma no genera.
enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED

  @@schema("projects")
}

/// Un bloque de tiempo dentro de un tablero Scrum.
///
/// ## Por qué vive en projects-service y no en tasks-service
///
/// Es una propiedad del **tablero** — como `BoardColumn` — y no de la tarea.
/// `Task.sprintId` (en tasks-service) apunta aquí igual que `Task.boardId` ya
/// apunta a `Board`: sin clave foránea entre microservicios, misma regla que
/// todas las referencias cruzadas de este backend.
///
/// ## Por qué el alcance no se congela en una tabla aparte
///
/// El burndown separa "alcance original" de "añadido después" comparando
/// `Task.sprintAssignedAt` contra `Sprint.startDate` (ver
/// `docs/PLAN-SCRUM-KANBAN.md`, D9) — no hace falta guardar una foto del
/// alcance al arrancar.
model Sprint {
  id      String       @id @default(uuid())
  boardId String
  board   Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  /// Opcional a propósito: no todo sprint necesita una frase que lo resuma.
  goal    String?
  status  SprintStatus @default(PLANNED)

  /// `null` mientras esté `PLANNED`. Se fija al iniciar (`sprint_start`), no al
  /// crear: crear un sprint es planearlo, no arrancar el reloj.
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  /// Como mucho un `ACTIVE` por tablero (D3). Este índice no impone la regla
  /// —Postgres no tiene "único condicionado a un valor de enum" sin un índice
  /// parcial escrito a mano en SQL—, pero sí hace barata la consulta que la
  /// aplica: "¿hay ya un sprint activo en este tablero?" antes de crear otro.
  @@index([boardId, status])
  @@schema("projects")
  @@map("sprints")
}

model BoardColumn {
  id      String @id @default(uuid())
  name    String
  order   Int
  /// Token del design system (`COLUMN_COLORS`), no un hex: así el punto de la
  /// columna sigue el tema. Antes el color lo elegía la interfaz **por
  /// posición**, así que reordenar una columna le cambiaba el color; guardándolo
  /// aquí el color es de la columna y viaja con ella.
  color   String @default("primary")
  /// Límite de trabajo en curso (WIP). `null` = sin límite.
  ///
  /// ⚠️ **Es blando: se avisa, no se bloquea** (D13 de
  /// `docs/PLAN-SCRUM-KANBAN.md`). Rechazar un arrastre porque la columna está
  /// llena castiga justo el momento en que el equipo tiene prisa, y el límite
  /// existe para abrir una conversación, no para cerrar la puerta.
  wipLimit Int?
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@schema("projects")
  @@map("board_columns")
}

model ProjectRole {
  id          String          @id @default(uuid())
  name        String
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions Json
  members     ProjectMember[]
  invitations ProjectInvitation[]

  @@unique([projectId, name])
  @@schema("projects")
  @@map("project_roles")
}

/// Estados de una invitación a un proyecto.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@schema("projects")
}

/// Invitación a un proyecto.
///
/// Existe porque antes no había ninguna: `POST /projects/:id/members` daba de
/// alta directamente y la persona se enteraba al abrir el proyecto. Ahora el
/// alta solo ocurre cuando quien recibe la invitación la acepta.
///
/// El `ProjectMember` se crea **al aceptar**, no aquí: mientras está pendiente
/// no hay membresía y por tanto no hay permisos.
model ProjectInvitation {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// A quién se invita.
  userId        String
  /// Rol con el que entrará si acepta.
  projectRole   ProjectRole      @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  projectRoleId String
  /// Quién la envió, para poder decirlo en la interfaz.
  invitedBy     String
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  /// Una sola invitación viva por persona y proyecto. Las resueltas se
  /// conservan como historial, así que la unicidad se aplica en el servicio
  /// solo sobre las pendientes.
  @@index([userId, status])
  @@index([projectId, status])
  @@schema("projects")
  @@map("project_invitations")
}

model ProjectMember {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  projectRole   ProjectRole @relation(fields: [projectRoleId], references: [id])
  projectRoleId String
  joinedAt      DateTime    @default(now())

  @@unique([projectId, userId])
  /// «¿En qué proyectos estoy?», que es por donde empieza medio producto:
  /// `GET /projects`, la lista de contactos del chat y el reparto de presencia
  /// arrancan todos por aquí.
  ///
  /// ⚠️ **El `@@unique` de arriba no sirve para esto.** Un índice compuesto solo
  /// se puede usar por su prefijo, y ahí el prefijo es `projectId`: una consulta
  /// que solo filtra por `userId` no puede aprovecharlo y acaba en `Seq Scan`
  /// sobre la tabla entera —confirmado con `EXPLAIN ANALYZE`—. Es la clase de
  /// cosa que no se nota en desarrollo y crece con usuarios × proyectos.
  @@index([userId])
  @@schema("projects")
  @@map("project_members")
}

/// Tipos de aviso. Cada uno describe **algo que ya pasó**, no una tarea
/// pendiente: las invitaciones por responder siguen viviendo en su propia tabla
/// y el panel las enseña aparte, porque esperan una decisión.
enum NotificationType {
  /// Te han invitado a un proyecto.
  INVITATION_RECEIVED
  /// Quien invitaste aceptó. Le llega a quien invitó.
  INVITATION_ACCEPTED
  /// Quien invitaste rechazó. Le llega a quien invitó.
  INVITATION_REJECTED
  /// Alguien se fue por su cuenta. Le llega al dueño.
  MEMBER_LEFT
  /// Te sacaron de un proyecto.
  MEMBER_REMOVED
  /// Te asignaron una tarea.
  TASK_ASSIGNED
  /// Te quitaron de una tarea.
  TASK_UNASSIGNED
  /// ─── Automatización ─────────────────────────────────────────────────────
  ///
  /// ⚠️ **Hay un tipo por disparador, y no es por gusto.** El aviso salía del
  /// destinatario elegido —a quien lleva el proyecto, `AUTOMATION_TASK_STALE`;
  /// a los encargados, `AUTOMATION_TASK_DUE_SOON`— y con dos disparadores
  /// coincidía por casualidad. Con diez, crear una tarea avisaba de que
  /// «lleva varios días sin movimiento»: el texto no describía lo que había
  /// pasado, describía a quién se le contaba.
  ///
  /// El catálogo de `automation-service` es quien empareja disparador y tipo.
  /// Un disparador nuevo sin su tipo aquí no compila allí.
  AUTOMATION_TASK_DUE_SOON
  AUTOMATION_TASK_STALE
  AUTOMATION_TASK_OVERDUE
  AUTOMATION_TASK_UNASSIGNED
  AUTOMATION_TASK_CREATED
  AUTOMATION_TASK_MOVED
  AUTOMATION_TASK_COMPLETED
  AUTOMATION_TASK_REOPENED
  AUTOMATION_TASK_ASSIGNEES_CHANGED
  AUTOMATION_TASK_DUE_DATE_CHANGED

  @@schema("projects")
}

/// Un aviso para una persona.
///
/// Vive en projects-service porque este servicio ya es dueño de las membresías y
/// las invitaciones, que son la mayoría de los eventos. Los de tarea los emite
/// tasks-service, que **ya habla con projects** para comprobar permisos: no
/// añade ninguna dependencia nueva ni ningún ciclo.
///
/// ⚠️ **No tiene clave foránea con `Project` ni con nada.** Es a propósito: un
/// aviso es un hecho del pasado y tiene que sobrevivir al borrado de aquello de
/// lo que habla. Por eso guarda `projectName` y `taskTitle` como **copia del
/// momento**; si el proyecto desaparece, el aviso sigue leyéndose.
model Notification {
  id          String           @id @default(uuid())
  /// Quién lo recibe.
  userId      String
  type        NotificationType
  /// Quién lo provocó. Nunca es `userId`: a nadie se le avisa de lo que hizo.
  actorId     String?
  projectId   String?
  projectName String?
  organizationId String?
  organizationName String?
  taskId      String?
  taskTitle   String?
  /// `null` mientras no se haya leído. Guarda el cuándo, no solo el si.
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  /// Los dos accesos reales: la lista de alguien y su contador de no leídos.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@schema("projects")
  @@map("notifications")
}

/// De qué es un canal de chat.
enum ChatChannelKind {
  /// El chat del equipo de un proyecto. Quién entra lo dice la membresía.
  PROJECT
  /// Una conversación privada entre dos personas.
  DIRECT

  @@schema("projects")
}

/// Un canal de chat.
///
/// ## Por qué un modelo común para el chat de proyecto y el privado
///
/// Responder, reaccionar, mencionar, silenciar y contar lo no leído tienen que
/// funcionar **igual en los dos**. Con dos estructuras paralelas serían cinco
/// cosas duplicadas que divergen a la primera corrección que se aplique solo en
/// una. Aquí el canal es lo único que cambia; todo lo que cuelga de él es común.
///
/// ## Quién participa se responde distinto según el tipo, y es a propósito
///
/// - **PROJECT** — participan los miembros del proyecto, y eso vive en
///   `project_members`. **No se copia aquí.** Duplicarlo obligaría a
///   sincronizar cada alta y cada baja, y un fallo de sincronización es alguien
///   que sigue leyendo un chat del que le echaron.
/// - **DIRECT** — participan exactamente las dos personas de `directUserA` y
///   `directUserB`. Es estructural: no hay tabla que consultar ni que mantener.
///
/// Por eso `ChatChannelState` **no** dice quién participa: solo guarda el
/// estado de cada cual (hasta dónde leyó, si lo silenció).
model ChatChannel {
  id   String          @id @default(uuid())
  kind ChatChannelKind

  /// Solo en PROJECT. Único: un proyecto tiene un chat, y solo uno.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Los dos participantes de un DIRECT, **siempre ordenados** (A < B).
  ///
  /// ⚠️ El orden no es cosmético: es lo que hace que el par sea único. Sin
  /// ordenarlos, que Ana escriba a Juan y Juan escriba a Ana crearía dos
  /// conversaciones distintas y cada uno vería la mitad de lo hablado.
  directUserA String?
  directUserB String?

  createdAt DateTime @default(now())

  states   ChatChannelState[]
  messages ChatMessage[]
  attachments ChatAttachment[]

  @@unique([directUserA, directUserB])
  /// La bandeja de conversaciones de alguien: las suyas, por los dos lados.
  @@index([directUserA])
  @@index([directUserB])
  @@schema("projects")
  @@map("chat_channels")
}

/// El estado de una persona en un canal: hasta dónde leyó y si lo silenció.
///
/// ⚠️ **Que exista esta fila NO significa que puedas entrar al canal.** Se crea
/// sola en cuanto alguien abre un chat o lo silencia. Quién puede leer lo decide
/// el guard del gateway con los permisos del proyecto, o los dos `directUser`
/// del canal. Tratar esta tabla como control de acceso sería dar acceso a
/// cualquiera que haya pasado por ahí una vez.
///
/// ⚠️ **Lo no leído es un instante, no una marca por mensaje.** La alternativa
/// crece con el producto de mensajes por lectores para responder a lo que es un
/// contador: mil mensajes y seis personas son seis mil filas para pintar un
/// número.
model ChatChannelState {
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String

  /// Sin valor = nunca lo ha abierto = todo está sin leer.
  lastReadAt DateTime?

  /// Cuándo lo silenció. `null` = suena. Guarda el cuándo y no solo el si, por
  /// el mismo motivo que `Notification.readAt`.
  mutedAt DateTime?

  /// Cuándo lo eliminó/ocultó. `null` = visible. 
  /// Si llega un mensaje nuevo después de esta fecha, el chat vuelve a aparecer.
  hiddenAt DateTime?

  @@id([channelId, userId])
  @@index([userId])
  @@schema("projects")
  @@map("chat_channel_states")
}

/// Un mensaje.
///
/// ## Tiene clave foránea, al revés que `Notification`
///
/// Un aviso es un hecho del pasado y debe sobrevivir al borrado de aquello de lo
/// que habla; por eso guarda copias del nombre. Un mensaje no: sin su canal no
/// significa nada y nadie puede leerlo, así que cascadea en vez de dejar
/// huérfanos que ocupan sitio para siempre.
///
/// ## Las menciones y las referencias viven **dentro del texto**
///
/// No hay tabla de menciones. El cuerpo las guarda con el nombre dentro:
///
///     @[Juan Pérez](user:2222…)      /[Sprint 1](board:88ab…)
///
/// ⚠️ Es lo que hace que **no se rompan**: si sacan a Juan del equipo o borran
/// el tablero, el nombre ya está escrito en el mensaje y se pinta como texto
/// plano. Degradar no necesita ninguna consulta, que es justo lo que falla
/// cuando la referencia es solo un id.
model ChatMessage {
  id        String      @id @default(uuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Quién lo escribió. **Sin clave foránea**: el usuario vive en
  /// credentials-service, en otro esquema y bajo otro dueño. Misma regla que
  /// `Notification.userId` y `ProjectMember.userId`.
  authorId String
  body     String

  /// Cuándo se editó por última vez. `null` mientras no se ha tocado.
  ///
  /// Editar **no cambia el autor ni el momento original**: solo se marca que el
  /// texto se reescribió después, para que la marca «editado» no mienta. Un
  /// mensaje editado sigue respondiendo a lo que respondía y sigue donde estaba.
  editedAt DateTime?

  /// A qué mensaje responde.
  ///
  /// `SetNull` y no `Cascade`: borrar un mensaje **no** puede llevarse por
  /// delante las respuestas que provocó, que son de otras personas y siguen
  /// teniendo sentido. La respuesta se queda sin cita, no desaparece.
  replyToId String?
  replyTo   ChatMessage?  @relation("respuestas", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies   ChatMessage[] @relation("respuestas")

  /// Si fluye por la conversación o vive solo dentro de su hilo.
  ///
  /// ⚠️ **No es lo mismo que `replyToId`.** Los dos van con la cita —el hilo
  /// también la necesita, para saber de qué mensaje es respuesta—, pero
  /// responden preguntas distintas: `replyToId` dice a quién cita, esto dice
  /// si el resultado se ve en la conversación general o solo al abrir el
  /// hilo. «Responder» desde el compositor principal deja esto en `true`: es
  /// un mensaje normal que además cita a otro. Escribir dentro del panel del
  /// hilo lo deja en `false`: existe únicamente ahí. Confundir los dos era
  /// el fallo — toda respuesta se convertía en hilo sin que quien escribía
  /// lo pidiera.
  visibleEnChat Boolean @default(true)

  /// Cuándo se fijó. `null` mientras no está fijado.
  ///
  /// Fijar no cambia el texto: deja el mensaje anclado a la conversación para
  /// que no se pierda en el historial. La lista de fijados es «los que no son
  /// nulos», y el índice de abajo es justo lo que la lee.
  pinnedAt DateTime?
  /// Quién lo fijó, para la marca. Sin clave foránea, igual que `authorId`.
  pinnedById String?

  /// Cuándo se borró. `null` mientras el mensaje está vivo.
  ///
  /// ## Por qué queda la fila
  ///
  /// El borrado era un `deleteMany` y la fila desaparecía. Eso deja **un hueco
  /// mudo** en la conversación: quien estaba leyendo ve que algo ha cambiado de
  /// sitio y no sabe si se borró un mensaje, si falló la carga o si nunca
  /// existió. Peor con `replyTo`, que es `SetNull`: la respuesta se quedaba sin
  /// cita y colgando de nada.
  ///
  /// Ahora la fila se queda como **lápida**: sale en su sitio del historial
  /// diciendo que ahí había un mensaje que se borró, y las respuestas que lo
  /// citaban lo siguen citando.
  ///
  /// ⚠️ **Y el contenido sí se va de verdad.** `body` se vacía, las reacciones
  /// se borran y los adjuntos también —con sus bytes—. Lo que sobrevive es el
  /// hecho de que hubo un mensaje, su autor y su hora, que es lo que la
  /// conversación necesita para seguir teniendo sentido. Un borrado que dejara
  /// el texto guardado «por si acaso» no sería un borrado.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  reactions   ChatReaction[]
  attachments ChatAttachment[]

  /// El único acceso que existe: los últimos mensajes de un canal, y los
  /// anteriores a uno dado al subir por el historial. Las dos consultas son
  /// este índice leído al revés.
  @@index([channelId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([replyToId])
  @@schema("projects")
  @@map("chat_messages")
}

/// Metadatos de un archivo adjunto a un mensaje de chat.
///
/// ## Los bytes no están aquí
///
/// Viven en `ChatAttachmentBlob` —en Postgres, hoy— o en el proveedor de
/// almacenamiento de objetos que se active (GCS). Separarlos es lo que permite
/// listar mensajes sin arrastrar megabytes: el listado consulta esta tabla y
/// los bytes solo se leen en la ruta de descarga.
///
/// ## El `messageId` es nulo hasta que el mensaje se envía
///
/// El archivo se sube **antes** de escribir el mensaje, y queda en borrador
/// (`messageId: null`) hasta que el mensaje lo reclama. Así el cliente puede
/// adjuntar varios, enseñarlos como chips y enviarlos todos de una vez con el
/// cuerpo. Un borrador abandonado se queda ahí hasta que quien lo subió lo
/// borra (mismo permiso que subirlo).
///
/// ## Por qué no se mide aquí el acceso
///
/// Quién puede ver un adjunto es quién puede ver la conversación, y eso se
/// decide por el canal —con el guard del proyecto o con `ChannelsService` para
/// los privados. Este modelo solo guarda el hecho.
model ChatAttachment {
  id         String       @id @default(uuid())
  channelId  String
  channel    ChatChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId  String?
  message    ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Nombre con el que se subió, saneado. Es lo que se ofrece al descargar.
  filename   String
  mimeType   String
  /// Bytes reales del archivo, medidos en el servidor y no declarados por el cliente.
  size       Int
  /// Quién lo subió. Sin clave foránea, igual que `authorId` del mensaje.
  uploadedBy String
  createdAt  DateTime     @default(now())

  blob ChatAttachmentBlob?

  @@index([channelId, messageId])
  @@index([messageId])
  @@schema("projects")
  @@map("chat_attachments")
}

/// Los bytes de un adjunto de chat, en su propia fila.
///
/// Uno a uno con `ChatAttachment`, y **solo cuando el proveedor activo es
/// Postgres**. Si el almacenamiento de objetos (GCS) toma el relevo, esta
/// tabla queda vacía y los bytes viven en el bucket: la API no cambia, quien
/// la consume no se entera de dónde está el archivo.
model ChatAttachmentBlob {
  attachmentId String          @id
  attachment   ChatAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  /// `bytea`. Postgres lo saca del bloque principal vía TOAST.
  data         Bytes

  @@schema("projects")
  @@map("chat_attachment_blobs")
}

/// Una reacción a un mensaje.
///
/// La clave primaria es el trío: la misma persona puede poner varias reacciones
/// distintas al mismo mensaje, pero **la misma dos veces no**. Eso convierte
/// «reaccionar» en una operación idempotente y hace que quitarla sea un borrado
/// exacto, sin buscar cuál de las suyas era.
model ChatReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  /// El emoji tal cual. Se valida contra una lista corta antes de guardarlo:
  /// un campo de texto libre aquí es un sitio más donde meter lo que sea.
  emoji     String
  createdAt DateTime    @default(now())

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@schema("projects")
  @@map("chat_reactions")
}

/// La disposición del lienzo de Análisis: **de una persona en un proyecto**.
///
/// ## Por qué es de la persona y no del proyecto
///
/// Se decidió antes de escribir el modelo, porque cambia el modelo entero. Un
/// lienzo por proyecto necesitaría una segunda línea de permiso —leerlo con
/// `canViewReports`, reorganizarlo con `canEditProject`—, una pantalla que
/// explique por qué el botón de mover está apagado, y convivir con que dos
/// personas reorganizando a la vez es un último-que-guarda-gana silencioso.
/// Por persona no hace falta nada de eso: si llegas a la pantalla tienes
/// `canViewReports`, y tu lienzo es tuyo. Es la misma línea que ya siguen las
/// conversaciones del asistente, que también son de una persona en un proyecto.
///
/// Lo que se pierde y conviene decir: el equipo no comparte vista, y montar la
/// del compañero es volver a arrastrar. Si algún día hace falta, la forma de
/// añadirlo es una tabla de **plantilla del proyecto** aparte y una regla de
/// precedencia, no convertir esta en compartida.
///
/// ## Y por qué sí tiene clave foránea, al revés que `Notification`
///
/// Un aviso es un hecho del pasado y tiene que sobrevivir al proyecto del que
/// habla; por eso guarda copias del nombre y no cascadea. Un lienzo es lo
/// contrario: **no significa nada sin su proyecto**. Sus widgets apuntan a
/// columnas y etiquetas que dejan de existir con él, y conservarlo solo dejaría
/// filas que nadie puede volver a leer. Como vive en el mismo esquema que
/// `Project`, la cascada es de la base y no hay que acordarse de limpiarla al
/// borrar —que es justo donde se olvidan estas cosas.
///
/// No hay clave foránea hacia el usuario: vive en credentials-service, bajo otro
/// dueño. Ahí sí se aplica la regla de siempre.
model ReportLayout {
  userId    String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Los widgets con su posición y su tamaño, tal cual los deja el lienzo.
  ///
  /// Es `Json` y no una tabla por widget **a propósito**: se escribe entero en
  /// cada guardado y se lee entero en cada carga; nunca se consulta un widget
  /// suelto ni se agrega nada sobre ellos. Una tabla obligaría a un `delete` +
  /// `createMany` en transacción para conseguir exactamente lo mismo.
  ///
  /// ⚠️ Lo que Postgres no valida lo valida `SaveReportLayoutDto` **antes** de
  /// llegar aquí: tipo de widget dentro del catálogo, métricas dentro del
  /// conjunto cerrado y un tope de widgets. Un `Json` sin esa puerta delante es
  /// un campo de texto libre con otro nombre.
  widgets   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// El único acceso que existe: «mi lienzo de este proyecto».
  @@id([userId, projectId])
  @@schema("projects")
  @@map("report_layouts")
}
