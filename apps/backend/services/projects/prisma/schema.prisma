generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["projects"]
}

model Project {
  id          String          @id @default(uuid())
  /// Único **por dueño**, no globalmente: dos equipos distintos pueden tener
  /// cada uno su "Sprint 1". Antes era `@unique` a secas y el nombre chocaba con
  /// el proyecto de gente que no conoces, sin forma de saber por qué.
  name        String

  /// El identificador legible de la URL: `/projects/rediseno-del-panel`.
  ///
  /// Único **global**, a diferencia de `name`, porque quien resuelve una URL es
  /// una persona que puede ver proyectos de varios dueños —dos "Sprint 1" de
  /// equipos distintos— y ahí el nombre solo no desambigua. Los choques se
  /// resuelven con un sufijo numérico (`sprint-1-2`) que pone
  /// `generarSlugUnico`; nadie lo escribe a mano, así que la unicidad global no
  /// devuelve el conflicto incomprensible que quitó `20260730020000`.
  ///
  /// Se regenera al renombrar. Los enlaces con el UUID **siguen funcionando
  /// siempre**: el guard acepta las dos formas, y por eso no hace falta guardar
  /// los slugs viejos.
  slug        String          @unique

  description String?
  ownerId     String
  workspaces  Workspace[]
  members     ProjectMember[]
  roles       ProjectRole[]
  invitations ProjectInvitation[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([ownerId, name])
  @@schema("projects")
  @@map("projects")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boards    Board[]
  createdAt DateTime @default(now())

  @@unique([projectId, name])
  @@schema("projects")
  @@map("workspaces")
}

model Board {
  id          String        @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     BoardColumn[]
  createdAt   DateTime      @default(now())

  @@schema("projects")
  @@map("boards")
}

model BoardColumn {
  id      String @id @default(uuid())
  name    String
  order   Int
  /// Token del design system (`COLUMN_COLORS`), no un hex: así el punto de la
  /// columna sigue el tema. Antes el color lo elegía la interfaz **por
  /// posición**, así que reordenar una columna le cambiaba el color; guardándolo
  /// aquí el color es de la columna y viaja con ella.
  color   String @default("primary")
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@schema("projects")
  @@map("board_columns")
}

model ProjectRole {
  id          String          @id @default(uuid())
  name        String
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions Json
  members     ProjectMember[]
  invitations ProjectInvitation[]

  @@unique([projectId, name])
  @@schema("projects")
  @@map("project_roles")
}

/// Estados de una invitación a un proyecto.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@schema("projects")
}

/// Invitación a un proyecto.
///
/// Existe porque antes no había ninguna: `POST /projects/:id/members` daba de
/// alta directamente y la persona se enteraba al abrir el proyecto. Ahora el
/// alta solo ocurre cuando quien recibe la invitación la acepta.
///
/// El `ProjectMember` se crea **al aceptar**, no aquí: mientras está pendiente
/// no hay membresía y por tanto no hay permisos.
model ProjectInvitation {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// A quién se invita.
  userId        String
  /// Rol con el que entrará si acepta.
  projectRole   ProjectRole      @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  projectRoleId String
  /// Quién la envió, para poder decirlo en la interfaz.
  invitedBy     String
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  /// Una sola invitación viva por persona y proyecto. Las resueltas se
  /// conservan como historial, así que la unicidad se aplica en el servicio
  /// solo sobre las pendientes.
  @@index([userId, status])
  @@index([projectId, status])
  @@schema("projects")
  @@map("project_invitations")
}

model ProjectMember {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  projectRole   ProjectRole @relation(fields: [projectRoleId], references: [id])
  projectRoleId String
  joinedAt      DateTime    @default(now())

  @@unique([projectId, userId])
  @@schema("projects")
  @@map("project_members")
}

/// Tipos de aviso. Cada uno describe **algo que ya pasó**, no una tarea
/// pendiente: las invitaciones por responder siguen viviendo en su propia tabla
/// y el panel las enseña aparte, porque esperan una decisión.
enum NotificationType {
  /// Te han invitado a un proyecto.
  INVITATION_RECEIVED
  /// Quien invitaste aceptó. Le llega a quien invitó.
  INVITATION_ACCEPTED
  /// Quien invitaste rechazó. Le llega a quien invitó.
  INVITATION_REJECTED
  /// Alguien se fue por su cuenta. Le llega al dueño.
  MEMBER_LEFT
  /// Te sacaron de un proyecto.
  MEMBER_REMOVED
  /// Te asignaron una tarea.
  TASK_ASSIGNED
  /// Te quitaron de una tarea.
  TASK_UNASSIGNED

  @@schema("projects")
}

/// Un aviso para una persona.
///
/// Vive en projects-service porque este servicio ya es dueño de las membresías y
/// las invitaciones, que son la mayoría de los eventos. Los de tarea los emite
/// tasks-service, que **ya habla con projects** para comprobar permisos: no
/// añade ninguna dependencia nueva ni ningún ciclo.
///
/// ⚠️ **No tiene clave foránea con `Project` ni con nada.** Es a propósito: un
/// aviso es un hecho del pasado y tiene que sobrevivir al borrado de aquello de
/// lo que habla. Por eso guarda `projectName` y `taskTitle` como **copia del
/// momento**; si el proyecto desaparece, el aviso sigue leyéndose.
model Notification {
  id          String           @id @default(uuid())
  /// Quién lo recibe.
  userId      String
  type        NotificationType
  /// Quién lo provocó. Nunca es `userId`: a nadie se le avisa de lo que hizo.
  actorId     String?
  projectId   String?
  projectName String?
  taskId      String?
  taskTitle   String?
  /// `null` mientras no se haya leído. Guarda el cuándo, no solo el si.
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  /// Los dos accesos reales: la lista de alguien y su contador de no leídos.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@schema("projects")
  @@map("notifications")
}
