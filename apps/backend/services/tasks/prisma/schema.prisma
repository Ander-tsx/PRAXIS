generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas = ["tasks"]
  url      = env("DATABASE_URL")
}

model Task {
  id           String         @id @default(uuid())
  title        String
  description  String?
  status       String
  boardId      String
  columnId     String
  /// Quién creó la tarea. Los encargados están en `assignees`.
  reporterId   String
  projectId    String
  parentTaskId String?
  parent       Task?          @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]         @relation("Subtasks")
  checklists   Checklist[]
  assignees    TaskAssignee[]
  labels       TaskLabel[]
  comments     TaskComment[]
  dueDate      DateTime?
  priority     Priority       @default(MEDIUM)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  /// Para «mis tareas»: se filtra por vencimiento dentro de los proyectos visibles.
  @@index([projectId, dueDate])
  @@schema("tasks")
  @@map("tasks")
}

/// Encargado de una tarea.
///
/// Sustituye al antiguo `Task.assigneeId`, que era un solo campo. Se migró en
/// vez de mantener los dos porque dos fuentes para el mismo hecho acaban
/// divergiendo, y «¿quién está asignado?» tendría dos respuestas: justo el
/// problema que ya tuvimos con los permisos guardados como array.
///
/// No hay clave foránea hacia el usuario: vive en otro microservicio y en otro
/// esquema. La comprobación de que es miembro del proyecto se hace en el
/// servicio, preguntando a projects-service.
model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  /// Quién lo asignó, para poder decirlo en la interfaz.
  assignedBy String
  assignedAt DateTime @default(now())

  /// Una persona no puede estar asignada dos veces a la misma tarea.
  @@unique([taskId, userId])
  /// El índice que hace barata la consulta de «mis tareas».
  @@index([userId])
  @@schema("tasks")
  @@map("task_assignees")
}

model Checklist {
  id        String  @id @default(uuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  completed Boolean @default(false)
  order     Int     @default(0)

  @@schema("tasks")
  @@map("checklists")
}

/// Comentario en una tarea.
///
/// `authorId` es un id sin clave foránea: el usuario vive en otro
/// microservicio. El nombre lo resuelve la interfaz contra los miembros del
/// proyecto, igual que con los encargados.
///
/// Se guarda `editedAt` aparte de `updatedAt` porque solo interesa marcar
/// «editado» cuando cambió el **texto**, no cada vez que Prisma toca la fila.
model TaskComment {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  /// El listado siempre va por tarea y en orden cronológico.
  @@index([taskId, createdAt])
  @@schema("tasks")
  @@map("task_comments")
}

/// Etiqueta de un proyecto.
///
/// Es **del proyecto y no del tablero**: así se reutiliza la misma etiqueta en
/// todos los tableros del proyecto, que es como funcionan las de Trello. Por
/// tablero quedarían aisladas y habría que recrearlas en cada uno.
///
/// No hay clave foránea hacia `Project`: vive en otro microservicio. Al borrar
/// un proyecto las limpia `task_purge`, igual que a las tareas.
model Label {
  id        String      @id @default(uuid())
  projectId String
  name      String
  /// Token de color del design system (`primary`, `error`, …), no un hex: así
  /// las etiquetas siguen el tema y no se salen de la paleta.
  color     String
  tasks     TaskLabel[]
  createdAt DateTime    @default(now())

  /// Dos etiquetas con el mismo nombre en un proyecto no distinguirían nada.
  @@unique([projectId, name])
  @@index([projectId])
  @@schema("tasks")
  @@map("labels")
}

/// Une una etiqueta con una tarea.
model TaskLabel {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  /// Clave compuesta: no hace falta un id propio y evita duplicados por diseño.
  @@id([taskId, labelId])
  @@index([labelId])
  @@schema("tasks")
  @@map("task_labels")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
  
  @@schema("tasks")
}
