generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["assistant"]
  url      = env("DATABASE_URL")
}

/// Cuánto da cada plan al mes vive en `@praxis/contracts` (`ASSISTANT_LIMITS`),
/// no aquí: el backend y el contador del chat tienen que leer el mismo número.
enum AssistantPlan {
  FREE
  PRO

  @@schema("assistant")
}

/// El plan de cada usuario.
///
/// **Sin fila = FREE.** No se crea nada al registrarse: una tabla que hay que
/// rellenar para todo el mundo antes de que sirva de algo es una migración
/// pendiente disfrazada, y el valor por defecto ya es el correcto.
///
/// No hay clave foránea hacia el usuario: vive en credentials-service, en otro
/// esquema y bajo otro dueño. Es la misma regla que siguen `task_events` y
/// `notifications`.
///
/// El pago va por **Stripe Checkout alojado**: la página de la tarjeta la sirve
/// Stripe, no nosotros, así que ningún dato de tarjeta pasa jamás por este
/// sistema. Aquí solo quedan los dos identificadores que Stripe devuelve, que
/// no son secretos y no sirven para cobrar nada.
///
/// ⚠️ **Quien decide el plan es el webhook, nunca la vuelta del navegador.** La
/// URL de éxito la puede escribir cualquiera en la barra de direcciones; si
/// pasar a PRO dependiera de visitarla, PRO sería gratis.
model AssistantSubscription {
  userId    String        @id
  plan      AssistantPlan @default(FREE)

  /// El cliente en Stripe. Se reutiliza entre compras para que el historial de
  /// facturación de una persona no se parta en varios clientes sueltos.
  stripeCustomerId String? @unique

  /// La suscripción activa. Es la clave por la que se busca al cancelar: el
  /// webhook de baja **no trae nuestro `userId`**, solo lo que es de Stripe.
  stripeSubscriptionId String? @unique

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@schema("assistant")
  @@map("assistant_subscriptions")
}

/// Consumo de un usuario en un mes. `period` es 'YYYY-MM'.
///
/// **Una fila por mes en vez de un contador que se reinicia**, y no es un
/// capricho: así queda el histórico de consumo, que es lo primero que hará
/// falta el día que existan planes de verdad. Un contador que se pone a cero
/// borra la única prueba de cuánto se usó esto.
///
/// Tampoco vive en Redis: un FLUSHALL regalaría 500 mensajes a todo el mundo, y
/// un contador que gobierna un coste real no puede depender de una caché que es
/// desechable por definición.
model AssistantUsage {
  id     String @id @default(uuid())
  userId String
  period String
  used   Int    @default(0)

  @@unique([userId, period])
  @@index([period])
  @@schema("assistant")
  @@map("assistant_usage")
}

/// Una conversación con el asistente.
///
/// Hasta ahora **no se guardaba ninguna**: el historial lo mandaba el cliente en
/// cada turno y el servidor no lo veía nunca. Recargar la página perdía el hilo,
/// y cruzar de zona —que en Multi-Zones es una recarga completa— también.
///
/// Es **de una persona**, y esa es la mitad que no cambia: lo que alguien le
/// escribe al asistente es suyo. `userId` no es solo para agrupar, es la clave
/// de acceso.
///
/// ⚠️ **`projectId` pasó a ser opcional, y es el cambio de fondo.** La
/// conversación nacía atada a un proyecto y el listado era «mis conversaciones
/// **de este proyecto**». Eso obligaba a elegir el proyecto **antes** de poder
/// hablar —con un desplegable, fuera de la conversación— y partía el historial
/// en tantas listas como proyectos tuvieras.
///
/// Ahora la conversación es tuya y el proyecto es un **foco**: empieza sin
/// ninguno —PRAX pregunta por cuál, dentro del propio chat— y puede cambiar a
/// mitad. Aquí se guarda el último, que es lo que la lista necesita para decir
/// de qué iba; el de cada turno vive en su `Message`.
///
/// ⚠️ **No se cargan varios proyectos a la vez, y no es una limitación
/// pendiente.** Los permisos son por proyecto y las herramientas se declaran con
/// ellos, así que con dos proyectos abiertos `canCreateTask` podría ser sí en uno
/// y no en otro y una sola lista de herramientas no puede expresarlo. Además el
/// briefing lleva **todas** las tareas del proyecto: cargar cinco multiplicaría
/// por cinco la ventana y empujaría las reglas fuera de la atención del modelo.
///
/// Sin clave foránea hacia el proyecto ni hacia el usuario: viven en otros
/// servicios. Al borrar el proyecto las limpia el gateway, como con las tareas.
model Conversation {
  id        String    @id @default(uuid())
  userId    String
  /// El **último** proyecto del que se habló. `null` mientras no se ha elegido.
  projectId String?
  /// Las primeras palabras del primer mensaje. Se puede renombrar a mano.
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// El listado es «mis conversaciones, la última arriba». Sin el proyecto.
  @@index([userId, updatedAt])
  @@schema("assistant")
  @@map("assistant_conversations")
}

enum MessageRole {
  USER
  MODEL

  @@schema("assistant")
}

/// Un turno. El texto tal cual se escribió o se respondió.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  text           String
  /// De qué proyecto iba **este** turno. `null` antes de elegir foco.
  ///
  /// ⚠️ Se guarda por mensaje y no solo en la conversación porque el foco cambia
  /// a mitad: sin esto, al releer un hilo que pasó por dos proyectos, todas las
  /// propuestas parecerían del último. Es también lo que permite pintar la marca
  /// de «ahora hablando de X» en el sitio exacto donde ocurrió.
  projectId      String?
  proposals      Proposal[]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@schema("assistant")
  @@map("assistant_messages")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DISCARDED

  @@schema("assistant")
}

/// Una propuesta del asistente, **con lo que se decidió sobre ella**.
///
/// Es una fila y no un JSON dentro del mensaje justamente por `status`. Al
/// reabrir una conversación de hace días sus tarjetas vuelven a aparecer, y sin
/// saber qué se decidió entonces habría dos formas de equivocarse: pulsar
/// «Aceptar» en algo que ya se aceptó —creando la tarea dos veces— o no
/// distinguir lo que se descartó a propósito de lo que quedó a medias.
///
/// Solo las `PENDING` conservan sus botones al releer.
///
/// `args` sí es Json: su forma depende de `tool` y ya la valida el servicio
/// antes de guardarla. Aquí solo se conserva lo que se propuso.
model Proposal {
  id         String         @id @default(uuid())
  messageId  String
  message    Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tool       String
  args       Json
  status     ProposalStatus @default(PENDING)
  resolvedAt DateTime?

  @@index([messageId])
  @@schema("assistant")
  @@map("assistant_proposals")
}
