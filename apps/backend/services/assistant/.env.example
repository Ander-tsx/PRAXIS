# assistant-service — TCP 3006
#
# El sexto microservicio. Lleva la cuota mensual (tabla propia) y es el único
# que habla con Gemini.

DATABASE_URL=postgresql://praxis:praxis123@localhost:5432/praxis?schema=assistant
TCP_PORT=3006

# reports-service: de ahí sale el contexto que ve el modelo. Este servicio no
# consulta tareas ni proyectos por su cuenta.
REPORTS_SERVICE_HOST=localhost
REPORTS_SERVICE_PORT=3005

# ⚠️ La clave de Gemini vive AQUÍ y en ningún otro sitio.
#
# Ni en el gateway, ni en el frontend, y desde luego nunca en una variable
# NEXT_PUBLIC_*: eso la publica en el JS que descarga el navegador. Que la
# llamada al tercero salga de un solo servicio es también lo que evita que una
# respuesta lenta de Gemini se meta en el camino por el que pasa todo lo demás.
GEMINI_API_KEY=
# `gemini-flash-latest` es un alias que se mantiene al día solo. Los ids fijos
# se retiran para las claves nuevas: `gemini-2.5-flash` ya responde 404 con una
# clave recién creada.
GEMINI_MODEL=gemini-flash-latest

LOG_LEVEL=info
NODE_ENV=development
