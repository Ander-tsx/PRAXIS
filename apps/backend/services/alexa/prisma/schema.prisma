generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["alexa"]
  url      = env("DATABASE_URL")
}

/// Sesión activa vinculada entre un usuario de Praxis y un dispositivo/usuario de Alexa.
/// El token opaco nunca se almacena en claro: solo su hash SHA-256 para verificación y revocación.
model AlexaSession {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  voiceTokenHash String    @unique @map("voice_token_hash")
  alexaUserId    String    @map("alexa_user_id")
  deviceId       String?   @map("device_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime  @default(now()) @map("last_used_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason")

  @@index([voiceTokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@schema("alexa")
  @@map("alexa_sessions")
}

/// Frase semilla de un solo uso generada desde la app web para vincular Alexa.
model AlexaLinkCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  phraseHash String    @unique @map("phrase_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  redeemedAt DateTime? @map("redeemed_at")

  @@index([phraseHash])
  @@index([userId])
  @@index([expiresAt])
  @@schema("alexa")
  @@map("alexa_link_codes")
}

/// Auditoría de consultas por voz — útil para depurar y detectar accesos anómalos.
model VoiceQueryLog {
  id        String   @id @default(uuid())
  userId    String
  linkId    String?
  projectId String?
  queryType String
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@schema("alexa")
  @@map("voice_query_logs")
}
