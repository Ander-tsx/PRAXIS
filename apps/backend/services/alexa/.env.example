DATABASE_URL=postgresql://praxis:praxis123@localhost:5432/praxis?schema=alexa
REDIS_URL=redis://localhost:6379
TCP_PORT=3007

# Secreto propio del token de voz — NO reutilizar el JWT_SECRET de la plataforma.
# El voice token es de solo lectura y de larga duración, por eso vive aparte.
VOICE_JWT_SECRET=
VOICE_TOKEN_EXPIRES_IN=90d

# Vinculación por frase semilla
VOICE_SEED_PHRASE_WORDS=5
VOICE_SEED_PHRASE_TTL_SECONDS=300
VOICE_REDEEM_MAX_ATTEMPTS=5
VOICE_REDEEM_WINDOW_SECONDS=600

# Convenciones de estado de tarea (comparación sin acentos y sin distinguir mayúsculas)
VOICE_COMPLETED_STATUSES=done,completed,complete,completada,completado,finalizada,finalizado,terminada,terminado,hecho,hecha
VOICE_IN_PROGRESS_STATUSES=in_progress,in progress,doing,en progreso,en curso,progreso
VOICE_BLOCKED_STATUSES=blocked,bloqueada,bloqueado,blocker,impedimento,on hold,en espera

# Una tarea abierta sin cambios durante estos días se considera estancada
VOICE_STALE_DAYS=7
# Semanas de historial usadas para calcular la velocidad del forecast
VOICE_FORECAST_WEEKS=4
# calendar = semana natural (lunes a domingo) | rolling = ventana móvil de 7 días
VOICE_WEEK_MODE=calendar

# Servicios de los que se leen los datos
CREDENTIALS_SERVICE_HOST=localhost
CREDENTIALS_SERVICE_PORT=3001
PROJECTS_SERVICE_HOST=localhost
PROJECTS_SERVICE_PORT=3003
TASKS_SERVICE_HOST=localhost
TASKS_SERVICE_PORT=3004

LOG_LEVEL=info
NODE_ENV=development
