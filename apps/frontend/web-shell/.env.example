# Variables de entorno para web-shell
# Copia este archivo como .env.local y rellena los valores reales

# URL del API Gateway NestJS
GATEWAY_URL=http://localhost:3000

# Secret compartido con el gateway para verificar la cookie de sesión localmente.
# Debe ser EXACTAMENTE el mismo valor que JWT_SECRET en apps/backend/gateway/.env
# Sin él, proxy.ts no puede renovar la sesión y el navbar público no sabe si
# quien navega ya tiene sesión iniciada.
JWT_SECRET=
