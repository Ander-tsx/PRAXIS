# Variables de entorno para auth-front
# Copia este archivo como .env.local y rellena los valores reales

# URL del API Gateway NestJS
GATEWAY_URL=http://localhost:3000

# Entorno — afecta el atributo Secure de la cookie de sesión
NODE_ENV=development

# Secret compartido con el gateway para verificar JWTs localmente
# Debe ser EXACTAMENTE el mismo valor que JWT_SECRET en apps/backend/gateway/.env
JWT_SECRET=

# ID de cliente de OAuth para el botón de «Entrar con Google».
#
# Es PÚBLICO por diseño: Next lo incrusta en el JavaScript que descarga el
# navegador. Lo que protege la cuenta no es ocultarlo, sino que Google solo
# emite tokens válidos para los orígenes autorizados del cliente.
#
# ⚠️ Se incrusta al CONSTRUIR, no al arrancar: tras cambiarlo hay que reiniciar
# `next dev` (en local) o reconstruir la imagen (en despliegue). Recargar el
# navegador no basta.
#
# Vacío = el botón no se dibuja y la entrada con contraseña funciona igual.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
