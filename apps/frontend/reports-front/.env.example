# Variables de entorno para reports-front
# Copia este archivo como .env.local y rellena los valores reales

# URL del API Gateway NestJS
GATEWAY_URL=http://localhost:3000

# Entorno — afecta el atributo Secure de la cookie de sesión
NODE_ENV=development

# Secret compartido con el gateway para verificar JWTs localmente.
# Debe ser EXACTAMENTE el mismo valor que JWT_SECRET en apps/backend/gateway/.env
JWT_SECRET=

# Lo que se enseña como precio del plan PRO, sin símbolo ni moneda. Ejemplo: 120
#
# ⚠️ Es solo el texto que sale en la tarjeta de PRO del chat. El precio de verdad
# vive en Stripe, en el `price_…` que usa el checkout (`STRIPE_PRICE_PRO` en el
# gateway): si los dos discrepan, manda Stripe.
NEXT_PUBLIC_PRECIO_PRO=
